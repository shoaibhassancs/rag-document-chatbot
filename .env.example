# Copy to .env and fill in. Never commit .env. Names only here; no real values.

# --- Provider keys ---
GROQ_API_KEY=
VOYAGE_API_KEY=
# Secret for the X-API-Key header on /ingest and DELETE /documents/{id} (needed from Milestone 2)
APP_API_KEY=
# Optional overflow slot for Gemini's free tier. Not built; leave empty.
GEMINI_API_KEY=

# --- Database (one setting). Compose overrides the host to "db" for the api container. ---
POSTGRES_USER=raguser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ragdb
# Host ports for Compose (chosen to avoid other local Postgres/API containers on 5432, 5433, 8000).
DB_HOST_PORT=5440
API_HOST_PORT=8010
DATABASE_URL=postgresql://raguser:change-me@localhost:5440/ragdb

# --- LLM roles (all Groq free plan, one OpenAI-compatible client) ---
# Each role has its own provider label, base URL, model, key setting, reasoning effort and
# output cap. Groq free limits per model: 30 req/min, 1K req/day, 8K tokens/min, 200K tokens/day.
# gpt-oss models accept low / medium / high; qwen3.8-27b accepts none / default / low / medium / high.

# Answer: openai/gpt-oss-20b is the PROVISIONAL default (D-036); the final choice between it and
# openai/gpt-oss-120b is made in Milestone 5 from evaluation numbers. Both have the same free limits.
ANSWER_LLM_PROVIDER=groq
ANSWER_LLM_BASE_URL=https://api.groq.com/openai/v1
ANSWER_LLM_MODEL=openai/gpt-oss-20b
ANSWER_LLM_API_KEY_VAR=GROQ_API_KEY
ANSWER_LLM_REASONING_EFFORT=low
ANSWER_LLM_MAX_OUTPUT_TOKENS=600
# Switch to the fallback model on a daily cap or repeated 429s (the switch is logged). Set it to
# the OTHER model: if ANSWER_LLM_MODEL is the 120b, set this to openai/gpt-oss-20b. Equal to the
# main model means no fallback (a warning is logged).
ANSWER_FALLBACK_ENABLED=true
ANSWER_FALLBACK_MODEL=openai/gpt-oss-120b

# Judge: a different model family from the answerer.
JUDGE_LLM_PROVIDER=groq
JUDGE_LLM_BASE_URL=https://api.groq.com/openai/v1
JUDGE_LLM_MODEL=qwen/qwen3.8-27b
JUDGE_LLM_API_KEY_VAR=GROQ_API_KEY
JUDGE_LLM_REASONING_EFFORT=low
JUDGE_LLM_MAX_OUTPUT_TOKENS=400

# History rewrite and clarify check (one small-model call before retrieval, Milestone 3/4).
REWRITE_LLM_PROVIDER=groq
REWRITE_LLM_BASE_URL=https://api.groq.com/openai/v1
REWRITE_LLM_MODEL=openai/gpt-oss-20b
REWRITE_LLM_API_KEY_VAR=GROQ_API_KEY
REWRITE_LLM_REASONING_EFFORT=low
REWRITE_LLM_MAX_OUTPUT_TOKENS=250

# --- Embeddings (Voyage) ---
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BASE_URL=https://api.voyageai.com/v1
# Without a payment method Voyage allows 3 requests/min and 10,000 tokens/min.
VOYAGE_REQUESTS_PER_MINUTE=3
VOYAGE_TOKENS_PER_MINUTE=10000
VOYAGE_MAX_BATCH_TOKENS=8000
# A chat question waits at most this long for its query embedding, then gets the busy reply (503).
QUERY_EMBED_MAX_WAIT_SECONDS=20

# --- Retrieval and chunking (starting values; tuned in Milestone 5) ---
TOP_K=5
# PROVISIONAL (0.40, confirmed by the owner in Milestone 3; re-check in Milestone 5) cosine cut-off. Chunks below it are dropped; if none are left the question
# is refused without calling the LLM. Blank = not set (nothing dropped). Set it from the output of
# `uv run python -m scripts.calibrate_threshold`, then tune in Milestone 5.
SIMILARITY_THRESHOLD=0.40
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=100

# --- Ingestion limits ---
MAX_UPLOAD_MB=10
MAX_FILES_PER_REQUEST=20
URL_TIMEOUT_SECONDS=10
URL_MAX_BYTES=2000000
# URL ingestion refuses private, loopback and link-local addresses unless this is true.
# To ingest a page served on your own machine (a local demo), set ALLOW_PRIVATE_URLS=true in .env.
# Inside Docker, "localhost" is the container itself, so use the CLI on the host for local URLs.
ALLOW_PRIVATE_URLS=false

# --- Memory, retries, logging ---
# Clarify-before-retrieving: one small-model call per question rewrites a follow-up into a
# standalone search query or asks one short clarifying question. false = search with the message
# as written (no extra Groq call). Idle sessions are forgotten after SESSION_TTL_HOURS.
CLARIFY_ENABLED=true
CLARIFY_PROMPT_VERSION=clarify_v1
HISTORY_TURNS=4
HISTORY_MESSAGE_MAX_CHARS=300
SESSION_TTL_HOURS=24
# Evaluation runner (eval/run_eval.py): judge prompts and the Groq limits it paces itself under.
JUDGE_CORRECTNESS_PROMPT_VERSION=judge_correctness_v1
JUDGE_FAITHFULNESS_PROMPT_VERSION=judge_faithfulness_v2
JUDGE_COMBINED_PROMPT_VERSION=judge_combined_v2
GROQ_TOKENS_PER_MINUTE=8000
GROQ_REQUESTS_PER_MINUTE=30
GROQ_TOKENS_PER_DAY=200000
GROQ_REQUESTS_PER_DAY=1000
EVAL_LIMIT_MARGIN=0.9
# Retries after a 429, then the answer model falls back (ANSWER_FALLBACK_*). A Retry-After longer
# than LLM_MAX_WAIT_SECONDS is treated as a daily cap: no waiting, fall back at once.
LLM_MAX_RETRIES=3
LLM_MAX_WAIT_SECONDS=20
LLM_TIMEOUT_SECONDS=30
# Versioned prompt file under prompts/ (without .txt).
ANSWER_PROMPT_VERSION=answer_v2
# Fixed reply texts (defaults are in app/config.py). Uncomment to change the wording:
# REFUSAL_MESSAGE="I couldn't find that in our documents. Please contact the clinic."
# BUSY_MESSAGE="The assistant is busy right now. Please try again in a minute."
# Demo UI (Milestone 6, UNVERIFIED draft). Behind the compose profile "ui", so a plain
# `docker compose up` does not start it. The UI container gets only APP_API_KEY (passed explicitly,
# never the whole .env). STREAMLIT_VERSION must be set to start it: a pinned version approved by
# the owner. Locally: uv run streamlit run ui/streamlit_app.py --server.port 8510
UI_HOST_PORT=8510
API_BASE_URL=http://127.0.0.1:8010
STREAMLIT_VERSION=1.66.0
LOG_LEVEL=INFO
