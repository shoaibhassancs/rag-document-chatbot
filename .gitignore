# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Local data (sample docs and eval questions are source and stay tracked)
pgdata/
data/uploads/
eval/.state/

# Raw per-question evaluation output and hand-check files (summary tables eval/results/*.md stay tracked)
eval/results/*.jsonl
eval/results/*-handcheck.md
# A smoke run is not a result: never committed or quoted (any file with "smoke" in its name)
eval/results/*smoke*

# Cached retrieval and prompt-comparison results (local, regenerated by scripts.compare_prompts)
data/calibration/cache/

# Pre-embedded seed file: local only, never committed (D-027). Keep this line.
data/seed/

# Models and large artifacts
models/
*.safetensors
*.gguf
*.bin

# Logs and build output
*.log
logs/
dist/
build/

# OS / editor
.DS_Store
.idea/
.vscode/
*.code-workspace

# Owner notes (kept local)
NOTES.md
study_notes.md

# Overnight reviewer channel (never committed)
handoff/

# Local Claude Code permission rules (never committed)
.claude/settings.local.json

# Handbook notes exports delivered by the chat assistant (local only, never committed)
Claude outputs/
