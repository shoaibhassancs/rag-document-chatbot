# UNVERIFIED DRAFT (Milestone 6, written overnight): this image has never been built. Streamlit was
# not installed or locked when this was written, so its version is a REQUIRED build argument with no
# default; the build stops if it is missing. The owner approves a pinned version (at least two weeks
# old, checked on PyPI) in the morning. Streamlit's own dependencies are NOT locked yet (they are not
# in uv.lock), so this image is not reproducible until Streamlit is added to the lock.
#
#   docker build -f Dockerfile.ui --build-arg STREAMLIT_VERSION=<version> -t rag-ui .
FROM python:3.12-slim

ARG STREAMLIT_VERSION
RUN test -n "$STREAMLIT_VERSION" || { echo "Set --build-arg STREAMLIT_VERSION=<pinned version approved by the owner>"; exit 1; }

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
RUN pip install "streamlit==${STREAMLIT_VERSION}" "httpx>=0.28.1"

COPY ui ./ui
COPY .streamlit ./.streamlit

RUN useradd --create-home appuser
USER appuser

EXPOSE 8501
CMD ["streamlit", "run", "ui/streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0"]
