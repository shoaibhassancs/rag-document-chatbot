# PARTLY VERIFIED (owner, Nov 17, 2026): the image builds (compose build, 1 min 52 s) and
# `import streamlit; print(streamlit.__version__)` inside it prints 1.66.0. Limits: (1) the image has
# never been started as a container (no `up` of the compose `ui` profile); (2) it installs with pip,
# so Streamlit's own dependencies are NOT taken from uv.lock: the image is not fully reproducible
# until it installs from uv.lock (not done).
# The Streamlit version is a build argument; compose defaults it to 1.66.0, the version in the `ui`
# group of uv.lock. Run directly, the build stops if it is missing.
#
#   docker build -f Dockerfile.ui --build-arg STREAMLIT_VERSION=<version> -t rag-ui .
FROM python:3.12-slim

ARG STREAMLIT_VERSION
RUN test -n "$STREAMLIT_VERSION" || { echo "Set --build-arg STREAMLIT_VERSION=<pinned version approved by the owner>"; exit 1; }

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
RUN pip install "streamlit==${STREAMLIT_VERSION}" "httpx>=0.28.1"

COPY ui ./ui
COPY .streamlit ./.streamlit

RUN useradd --create-home appuser
USER appuser

EXPOSE 8501
CMD ["streamlit", "run", "ui/streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0"]
